# Postgres connection string (required)
# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the pooled connection (port 6543) on a serverless host such as Vercel.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Admin login credentials. Both can be controlled from your host dashboard
# without code changes or database resets. If ADMIN_USERNAME is not set,
# defaults to "admin". If ADMIN_PASSWORD is not set, a random password is
# generated and logged on first request.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# JWT secret for admin auth tokens (required in production)
JWT_SECRET=your-secret-key-change-this
